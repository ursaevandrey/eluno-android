diff --git a/src/platform/android/java/chip/platform/NsdTimeouts.java b/src/platform/android/java/chip/platform/NsdTimeouts.java
new file mode 100644
index 00000000..c03474f6
--- /dev/null
+++ b/src/platform/android/java/chip/platform/NsdTimeouts.java
@@ -0,0 +1,24 @@
+package chip.platform;
+
+import java.util.concurrent.ScheduledThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+
+/** Shared process scheduler: cancelled tasks release captures, idle threads expire. */
+final class NsdTimeouts {
+  private static final ScheduledThreadPoolExecutor EXECUTOR = create();
+
+  private static ScheduledThreadPoolExecutor create() {
+    ScheduledThreadPoolExecutor executor = new ScheduledThreadPoolExecutor(1, runnable -> {
+      Thread thread = new Thread(runnable, "ElunoNsdTimeout");
+      thread.setDaemon(true);
+      return thread;
+    });
+    executor.setRemoveOnCancelPolicy(true);
+    executor.setKeepAliveTime(1, TimeUnit.SECONDS);
+    executor.allowCoreThreadTimeOut(true);
+    return executor;
+  }
+
+  static ScheduledThreadPoolExecutor executor() { return EXECUTOR; }
+  private NsdTimeouts() {}
+}

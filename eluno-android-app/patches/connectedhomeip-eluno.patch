+    CHIP_ERROR err = wrapper->Controller()->StopCommissionableDiscovery();
+    if (err != CHIP_NO_ERROR)
+    {
+        JniReferences::GetInstance().ThrowError(env, sChipDeviceControllerExceptionCls, err);
